// Vicinae merges this with its defaults and may rewrite it after GUI edits.
{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": true,
   "pixmap_cache_mb": 96,
   "font": {
      "rendering": "native",
      "normal": {
         "family": "auto",
         "size": 12
      }
   },
   "theme": {
      "dark": {
         "name": "vicinae-dark",
         "icon_theme": "Adwaita"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "providers": {
      "applications": {
         "preferences": {
            "launchPrefix": "dotfiles-app"
         }
      }
   },
   "launcher_window": {
      "opacity": 0.94,
      "rounding": 8,
      "client_side_decorations": {
         "enabled": true,
         "border_width": 1
      },
      "size": {
         "width": 920,
         "height": 575
      },
      "blur": {
         "enabled": false
      },
      "layer_shell": {
         "layer": "top",
         "keyboard_interactivity": "on_demand",
         "enabled": true
      }
   }
}
