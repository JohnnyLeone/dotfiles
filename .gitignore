# Editor and generated files
*~
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist
__pycache__/
*.pyc
.DS_Store
.directory
.Trash-*

# Private and per-machine settings
.extra
.gitconfig.local
.tmux.conf.local
.config/kitty/local.conf
.uuid
.rainbow_oauth

# Keep GnuPG preferences, never keyrings or key material
.gnupg/*
!.gnupg/gpg.conf
!.gnupg/gpg-agent.conf

# Keep reusable IRC themes/plugins, not identities, servers, or runtime state
.irssi/away.log
.irssi/config*
.irssi/nicknames_whitelist
.irssi/otr
.irssi/saved_colors
.irssi/scripts/autorun/blocker.pl
.irssi/startup
