# Portable container helpers retained from the original Docker configuration.
# Functions run only when explicitly called; native desktop commands stay native.
dcleanup() {
    command -v docker >/dev/null 2>&1 || { printf 'dcleanup requires Docker.\n' >&2; return 127; }
    command docker container prune "$@" && command docker image prune "$@"
}
del_stopped() {
    command -v docker >/dev/null 2>&1 || { printf 'del_stopped requires Docker.\n' >&2; return 127; }
    local container running
    for container in "$@"; do
        running=$(command docker inspect --format '{{.State.Running}}' "$container") || return
        if [ "$running" = false ]; then command docker rm "$container" || return; fi
    done
}
relies_on() {
    command -v docker >/dev/null 2>&1 || { printf 'relies_on requires Docker.\n' >&2; return 127; }
    local container running
    for container in "$@"; do
        running=$(command docker inspect --format '{{.State.Running}}' "$container") || return
        if [ "$running" != true ]; then command docker start "$container" || return; fi
    done
}
