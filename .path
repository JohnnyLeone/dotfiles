# Zsh's tied path array avoids duplicates when a shell is reloaded.
if [ -n "${ZSH_VERSION:-}" ]; then
    typeset -U path PATH
    path=("$HOME/.local/bin" "$HOME/bin" "$GOPATH/bin" "$HOME/.cargo/bin" "$HOME/.dotnet/tools" $path)
else
    export PATH="$HOME/.local/bin:$HOME/bin:$GOPATH/bin:$HOME/.cargo/bin:$HOME/.dotnet/tools:$PATH"
fi
