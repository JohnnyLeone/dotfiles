#!/usr/bin/env bash
# Open-PR listing, originally by Jess Frazelle; use GitHub CLI authentication.
set -euo pipefail
if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    echo 'Usage: openprs [OWNER] [gh search prs options...]'
    echo 'Defaults to GITHUB_USERNAME or your authenticated GitHub account.'
    exit 0
fi
command -v gh >/dev/null || { echo 'openprs requires GitHub CLI (gh).' >&2; exit 127; }
owner=${GITHUB_USERNAME:-}
if [[ $# -gt 0 && $1 != -* ]]; then owner=$1; shift; fi
[[ -n $owner ]] || owner=$(gh api user --jq .login)
exec gh search prs --owner "$owner" --state open --limit 100 \
    --json repository,number,title,url \
    --jq '.[] | "\(.repository.nameWithOwner // .repository.name)#\(.number): \(.title)\n\(.url)\n"' "$@"
