#!/usr/bin/env bash
# VM creation, originally by Jess Frazelle; use a native per-user libvirt session.
set -euo pipefail
if [[ ${1:-} == --help || ${1:-} == -h || $# -lt 2 ]]; then
    echo 'Usage: createvm NAME INSTALLER.iso [--apply]'
    echo 'Prints a plan by default. --apply creates a 2-vCPU, 2-GiB, 16-GiB VM.'
    echo 'Optional defaults: VM_MEMORY (MiB), VM_VCPUS, VM_DISK_GB.'
    exit 0
fi
name=$1
iso=$(realpath -e -- "$2")
shift 2
apply=false
for arg in "$@"; do
    case "$arg" in
        --apply) apply=true ;;
        *) echo "Unknown option: $arg" >&2; exit 2 ;;
    esac
done
[[ $name =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || { echo 'Invalid VM name.' >&2; exit 2; }
[[ -f $iso ]] || { echo 'Installer ISO is not a regular file.' >&2; exit 2; }
memory=${VM_MEMORY:-2048}
vcpus=${VM_VCPUS:-2}
disk_gb=${VM_DISK_GB:-16}
for value in "$memory" "$vcpus" "$disk_gb"; do
    [[ $value =~ ^[1-9][0-9]*$ ]] || { echo 'VM resource settings must be positive integers.' >&2; exit 2; }
done
directory="${XDG_DATA_HOME:-$HOME/.local/share}/libvirt/images"
disk="$directory/$name.qcow2"
[[ ! -e $disk && ! -L $disk ]] || { echo "Disk already exists: $disk" >&2; exit 1; }
vm_command=(virt-install --connect qemu:///session --name "$name"
    --memory "$memory" --vcpus "$vcpus" --disk "path=$disk,size=$disk_gb,format=qcow2"
    --cdrom "$iso" --osinfo detect=on,require=off --network user --graphics spice --noautoconsole)
printf '%q ' "${vm_command[@]}"
printf '\n'
if $apply; then
    command -v virt-install >/dev/null || { echo 'Install virt-install, libvirt, and QEMU first.' >&2; exit 127; }
    mkdir -p "$directory"
    exec "${vm_command[@]}"
fi
echo 'Preview only. Add --apply to create the VM.'
