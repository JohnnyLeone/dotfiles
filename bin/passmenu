#!/usr/bin/env bash
# Adapted from passmenu by zx2c4 for Vicinae/Wayland, retaining an X11 fallback.
set -euo pipefail
if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    echo 'Usage: passmenu [--type]'
    echo 'Select a pass entry with Vicinae and copy it, or type it using wtype.'
    exit 0
fi
typeit=false
if [[ ${1:-} == --type ]]; then typeit=true; shift; fi
[[ $# == 0 ]] || { echo 'Unexpected arguments. See passmenu --help.' >&2; exit 2; }
command -v pass >/dev/null || { echo 'passmenu requires pass; Super+P still opens Bitwarden.' >&2; exit 127; }
shopt -s nullglob globstar
prefix=${PASSWORD_STORE_DIR:-$HOME/.password-store}
files=("$prefix"/**/*.gpg)
[[ ${#files[@]} -gt 0 ]] || { echo 'The password store is empty.' >&2; exit 1; }
entries=("${files[@]#"$prefix"/}")
entries=("${entries[@]%.gpg}")
if command -v vicinae >/dev/null; then
    selected=$(printf '%s\n' "${entries[@]}" | vicinae dmenu --placeholder 'Password') || exit 0
elif [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v bemenu >/dev/null; then
    selected=$(printf '%s\n' "${entries[@]}" | bemenu -i -p Password) || exit 0
elif [[ -z ${WAYLAND_DISPLAY:-} ]] && command -v dmenu >/dev/null; then
    selected=$(printf '%s\n' "${entries[@]}" | dmenu -i -p Password) || exit 0
else
    echo 'No compatible menu found (Vicinae, bemenu, or X11 dmenu).' >&2
    exit 127
fi
[[ -n $selected ]] || exit 0
found=false
for entry in "${entries[@]}"; do [[ $entry != "$selected" ]] || found=true; done
$found || { echo 'The selection is not a password-store entry.' >&2; exit 1; }
if ! $typeit; then exec pass show --clip "$selected"; fi
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    command -v wtype >/dev/null || { echo '--type requires wtype on Wayland.' >&2; exit 127; }
    typer=(wtype -)
else
    command -v xdotool >/dev/null || { echo '--type requires xdotool on X11.' >&2; exit 127; }
    typer=(xdotool type --clearmodifiers --file -)
fi
secret=$(pass show "$selected")
printf '%s' "${secret%%$'\n'*}" | "${typer[@]}"
unset secret
