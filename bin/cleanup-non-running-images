#!/usr/bin/env bash
# Image cleanup, originally by Jess Frazelle. Keep images referenced by any container.
set -euo pipefail
case "${1:-}" in
    --help|-h)
        echo 'Usage: cleanup-non-running-images [--apply]'
        echo 'Shows disk usage by default. --apply asks Docker to prune unreferenced images.'
        exit 0 ;;
    ''|--apply) ;;
    *) echo 'Expected --apply or --help.' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo 'Too many arguments.' >&2; exit 2; }
command -v docker >/dev/null || { echo 'This command requires Docker.' >&2; exit 127; }
if [[ ${1:-} == --apply ]]; then
    exec docker image prune --all
fi
docker system df
echo 'Preview only. Add --apply to prune images; Docker will ask for confirmation.'
