#!/usr/bin/env bash
# Originally by Jess Frazelle; use brightnessctl rather than a Mac-specific sysfs path.
set -euo pipefail
case "${1:-}" in
    --help|-h|'')
        echo 'Usage: keyboard-backlight {up|down|total|off|info}'
        echo 'Set KEYBOARD_BACKLIGHT_DEVICE to select a specific LED device.'
        exit 0 ;;
    up) operation=(set +5%) ;;
    down) operation=(set 5%-) ;;
    total) operation=(set 100%) ;;
    off) operation=(set 0) ;;
    info) operation=(info) ;;
    *) echo 'Unknown keyboard-backlight action.' >&2; exit 2 ;;
esac
command -v brightnessctl >/dev/null || { echo 'This command requires brightnessctl.' >&2; exit 127; }
device=${KEYBOARD_BACKLIGHT_DEVICE:-}
if [[ -z $device ]]; then
    for path in /sys/class/leds/*kbd_backlight*; do
        [[ -r $path/brightness ]] || continue
        device=${path##*/}
        break
    done
fi
[[ -n $device ]] || { echo 'No keyboard backlight was detected on this machine.' >&2; exit 1; }
exec brightnessctl --class leds --device "$device" "${operation[@]}"
