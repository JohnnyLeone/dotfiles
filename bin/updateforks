#!/usr/bin/env bash
# Fork synchronization, originally by Jess Frazelle; preserve divergent commits.
set -euo pipefail
apply=false
owner=${GITHUB_USERNAME:-}
owner_argument=false
for arg in "$@"; do
    case "$arg" in
        --apply) apply=true ;;
        --help|-h)
            echo 'Usage: updateforks [OWNER] [--apply]'
            echo 'Lists the sync plan by default. --apply fast-forwards forks without forcing.'
            exit 0 ;;
        -*) echo "Unknown option: $arg" >&2; exit 2 ;;
        *) ! $owner_argument || { echo 'Specify only one owner.' >&2; exit 2; }; owner=$arg; owner_argument=true ;;
    esac
done
command -v gh >/dev/null || { echo 'updateforks requires GitHub CLI (gh).' >&2; exit 127; }
[[ -n $owner ]] || owner=$(gh api user --jq .login)
repos=$(gh repo list "$owner" --fork --no-archived --limit 1000 --json nameWithOwner --jq '.[].nameWithOwner')
while IFS= read -r repo; do
    [[ -n $repo ]] || continue
    printf 'Sync %s from its upstream default branch\n' "$repo"
    if $apply; then gh repo sync "$repo"; fi
done <<< "$repos"
$apply || echo 'Preview only. Add --apply to synchronize these forks.'
