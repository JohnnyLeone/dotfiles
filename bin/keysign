#!/usr/bin/env bash
# GPG signing helper, adapted from Isis Lovecruft's keysign (GPLv3).
set -euo pipefail
if [[ $# == 0 || ${1:-} == --help || ${1:-} == -h ]]; then
    echo 'Usage: keysign FINGERPRINT...'
    echo 'Displays each fingerprint, then opens the interactive GPG key editor.'
    echo 'Signing, exporting, and publishing remain explicit choices.'
    exit 0
fi
command -v gpg >/dev/null || { echo 'keysign requires GnuPG.' >&2; exit 127; }
for key in "$@"; do
    [[ $key =~ ^(0x)?[[:xdigit:]]{40}$ || $key =~ ^(0x)?[[:xdigit:]]{64}$ ]] || {
        echo 'Use a full OpenPGP fingerprint.' >&2; exit 2;
    }
    gpg --list-keys "$key" >/dev/null 2>&1 || gpg --recv-keys "$key"
    gpg --fingerprint "$key"
    read -r -p 'Fingerprint verified independently? Open key editor [y/N] ' answer
    [[ $answer == [yY] ]] || continue
    gpg --edit-key "$key"
    read -r -p 'Export this public key to an ASCII-armored file [y/N] ' answer
    if [[ $answer == [yY] ]]; then
        output="${key#0x}-signed.asc"
        gpg --armor --output "$output" --export "$key"
        printf 'Exported %s\n' "$output"
    fi
    read -r -p 'Publish this public key to the configured keyserver [y/N] ' answer
    if [[ $answer == [yY] ]]; then gpg --send-keys "$key"; fi
done
