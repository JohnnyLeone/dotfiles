#!/usr/bin/env bash
# Launch a graphical app in its own UWSM unit; preserve plain-session behavior.
set -euo pipefail
if [[ $# -eq 0 ]]; then
    echo 'Usage: dotfiles-app COMMAND [ARGUMENTS...]' >&2
    exit 2
fi
if [[ ${DOTFILES_UWSM_SESSION:-0} == 1 ]]; then
    exec uwsm app -- "$@"
fi
exec "$@"
