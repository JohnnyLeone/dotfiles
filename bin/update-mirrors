#!/usr/bin/env bash
# Git mirror maintenance, originally by Jess Frazelle.
set -euo pipefail
apply=false
parent=$HOME
directory_argument=false
for arg in "$@"; do
    case "$arg" in
        --apply) apply=true ;;
        --help|-h)
            echo 'Usage: update-mirrors [DIRECTORY] [--apply]'
            echo 'Plans updates for mirror repos directly under DIRECTORY (default: home).'
            echo 'Requires a distinct, explicit origin pushurl. --apply fetches and mirrors all refs.'
            exit 0 ;;
        -*) echo "Unknown option: $arg" >&2; exit 2 ;;
        *) ! $directory_argument || { echo 'Specify only one directory.' >&2; exit 2; }
           parent=$arg; directory_argument=true ;;
    esac
done
[[ -d $parent ]] || { echo 'Directory does not exist.' >&2; exit 2; }
while IFS= read -r -d '' repo; do
    git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || continue
    [[ $(git -C "$repo" config --get remote.origin.mirror 2>/dev/null || true) == true ]] || continue
    source=$(git -C "$repo" remote get-url origin)
    target=$(git -C "$repo" config --get remote.origin.pushurl || true)
    if [[ -z $target || $target == "$source" ]]; then
        printf 'Skipping %s: configure a separate origin pushurl first.\n' "$repo" >&2
        continue
    fi
    printf 'Mirror %s: %s -> %s\n' "$repo" "$source" "$target"
    if $apply; then
        git -C "$repo" fetch --prune origin
        git -C "$repo" push --mirror
    fi
done < <(find "$parent" -mindepth 1 -maxdepth 1 -type d -print0)
$apply || echo 'Preview only. Add --apply to fetch and mirror the configured repositories.'
