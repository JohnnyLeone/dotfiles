# Navigation and the original command shortcuts.
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias -- -='cd -'
alias dl='cd ~/Downloads'
alias g=git
alias k=kubectl
alias h=history
alias gc='git commit -v'
alias gcutc='TZ=UTC git commit -v'
alias l='ls -lhF --color=auto'
alias la='ls -lahF --color=auto'
alias lsd="ls -lhF --color=auto | command grep '^d'"
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias sudo='sudo '
alias cp='cp -i'
alias mv='mv -i'
alias untar='tar xvf'
alias week='date +%V'
alias timer='echo "Timer started. Stop with Ctrl-D." && date && time cat && date'
alias map='xargs -n1'
alias hosts='sudoedit /etc/hosts'
alias hd='hexdump -C'
alias pub4ip='dig -4 TXT +short o-o.myaddr.l.google.com @ns1.google.com'
alias pub6ip='dig -6 TXT +short o-o.myaddr.l.google.com @ns1.google.com'
alias localip="ip -o -4 addr show scope global | awk '{print \$4}'"
alias ips="ip -o addr show scope global | awk '{print \$4}'"

command -v xdg-open >/dev/null 2>&1 && alias open=xdg-open
command -v vim >/dev/null 2>&1 || alias vim=nvim

# Choose the clipboard for the current session when invoked.
pbcopy() {
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
        command wl-copy "$@"
    elif command -v xclip >/dev/null 2>&1; then
        command xclip -selection clipboard "$@"
    else
        printf 'No clipboard available in this session.\n' >&2
        return 1
    fi
}
pbpaste() {
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
        command wl-paste "$@"
    elif command -v xclip >/dev/null 2>&1; then
        command xclip -selection clipboard -o "$@"
    else
        printf 'No clipboard available in this session.\n' >&2
        return 1
    fi
}
c() { tr -d '\n' | pbcopy; }
cwd() { printf '%s' "$PWD" | pbcopy; }
pubkey() {
    local key
    for key in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_rsa.pub"; do
        if [ -r "$key" ]; then
            pbcopy < "$key" && printf 'Public key copied.\n'
            return
        fi
    done
    printf 'No default SSH public key found.\n' >&2
    return 1
}
afk() { "$HOME/.local/bin/dotfiles-hypr" lock; }
urlencode() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))' "$1"; }
command -v pdfunite >/dev/null 2>&1 && alias mergepdf=pdfunite
if command -v lwp-request >/dev/null 2>&1; then
    for method in GET HEAD POST PUT DELETE TRACE OPTIONS; do
        alias "$method=lwp-request -m $method"
    done
    unset method
fi
true
